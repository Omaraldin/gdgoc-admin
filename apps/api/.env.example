# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
SERVER_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# DB connection pool (optional — defaults shown)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_LIFETIME_MINS=30

# ── URLs ──────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ── Session / JWT ─────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-32-char-minimum-secret
SESSION_ACCESS_TOKEN_HOURS=1     # lifetime of short-lived JWT access token
SESSION_MAX_AGE_HOURS=168        # lifetime of long-lived JWT refresh token

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Kayan (Google OIDC) ───────────────────────────────────────────────────────
KAYAN_ISSUER=https://accounts.google.com
KAYAN_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
KAYAN_CLIENT_SECRET=your-google-client-secret
KAYAN_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local             # local | s3 | minio | cloudinary

# Cloudinary (STORAGE_DRIVER=cloudinary)
STORAGE_CLOUDINARY_CLOUD_NAME=your-cloud-name
STORAGE_ACCESS_KEY=your-api-key
STORAGE_SECRET_KEY=your-api-secret

# S3 / MinIO (STORAGE_DRIVER=s3 or minio)
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key
# STORAGE_USE_SSL=true

STORAGE_BUCKET_ASSETS=gdgoc-assets
STORAGE_BUCKET_CERTS=gdgoc-certificates

# Local driver (STORAGE_DRIVER=local)
# STORAGE_LOCAL_DIR=./data
# STORAGE_PUBLIC_PREFIX=/files

# ── SMTP OAuth ────────────────────────────────────────────────────────────────
# OAuth2 client credentials for chapters connecting Gmail / Outlook as their sender.
SMTP_GOOGLE_CLIENT_ID=your-smtp-google-client-id.apps.googleusercontent.com
SMTP_GOOGLE_CLIENT_SECRET=your-smtp-google-client-secret
# SMTP_MICROSOFT_CLIENT_ID=your-microsoft-client-id
# SMTP_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
SMTP_OAUTH_CALLBACK_URL=http://localhost:8080/api/v1/chapters/smtp/oauth/callback
SMTP_OAUTH_FRONTEND_URL=http://localhost:5173

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3
CERT_CACHE_DIR=./cert_cache      # directory where rendered certificates are cached on disk

# ── Fallback SMTP ─────────────────────────────────────────────────────────────
# Used when a chapter has no SMTP provider configured or their provider is unreachable.
# Must be a Gmail account with an App Password (not the account password).
FALLBACK_SMTP_EMAIL=your-fallback@gmail.com
FALLBACK_SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Rate limiting (optional — defaults shown) ─────────────────────────────────
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECS=60
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_SECS=60

# ── Misc ──────────────────────────────────────────────────────────────────────
BOOTSTRAP_SUPER_ADMIN=admin@example.com   # email to seed as super-admin on first boot
FONTS_DIR=./fonts                         # path to fonts used by the certificate renderer
