# API Environment Configuration
# Copy this to .env and fill in real values

# Server
APP_ENV=development
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgres://gdgoc:gdgoc_secret@localhost:5432/gdgoc_admin?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage — choose one driver: local | s3 | minio | cloudinary

# Cloudinary
# STORAGE_DRIVER=cloudinary
# STORAGE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# STORAGE_ACCESS_KEY=your-api-key
# STORAGE_SECRET_KEY=your-api-secret
# STORAGE_BUCKET_ASSETS=gdgoc-assets
# STORAGE_BUCKET_CERTS=gdgoc-certificates

# MinIO / S3-compatible
# STORAGE_DRIVER=s3
# STORAGE_ENDPOINT=localhost:9000
# STORAGE_ACCESS_KEY=gdgoc_minio
# STORAGE_SECRET_KEY=gdgoc_minio_secret
# STORAGE_BUCKET_ASSETS=gdgoc-assets
# STORAGE_BUCKET_CERTS=gdgoc-certificates
# STORAGE_USE_SSL=false

# Kayan Auth
KAYAN_BASE_URL=https://your-kayan-instance.example.com
KAYAN_CLIENT_ID=your-kayan-client-id
KAYAN_CLIENT_SECRET=your-kayan-client-secret
KAYAN_REDIRECT_URL=http://localhost:8080/auth/callback

# Session
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_MAX_AGE_HOURS=24

# SMTP OAuth2 (per-chapter Gmail / Outlook)
# Register redirect URI: http://localhost:8080/api/v1/chapters/smtp/oauth/callback
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
SMTP_GOOGLE_CLIENT_ID=
SMTP_GOOGLE_CLIENT_SECRET=
#
# Azure App Registrations → your app → Certificates & secrets
SMTP_MICROSOFT_CLIENT_ID=
SMTP_MICROSOFT_CLIENT_SECRET=
#
SMTP_OAUTH_CALLBACK_URL=http://localhost:8080/api/v1/chapters/smtp/oauth/callback
SMTP_OAUTH_FRONTEND_URL=http://localhost:5173

# Worker
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3
